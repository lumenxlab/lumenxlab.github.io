  <link rel="stylesheet" href="/css/style.css">

  <style>
    .member-page {
      background: #f6f8fb;
    }

    .member-page-main {
      padding: 54px 0 82px;
    }

    .member-simple-hero {
      display: grid;
      grid-template-columns: 235px minmax(0, 1fr);
      gap: 64px;
      align-items: center;
      padding: 42px 38px;
      border: 1px solid #d8e2ec;
      border-radius: 26px;
      background:
        radial-gradient(circle at 0 0, rgba(36, 120, 189, 0.09), transparent 36%),
        #ffffff;
      box-shadow: 0 16px 44px rgba(16, 42, 67, 0.08);
    }

    .member-simple-avatar {
      width: 206px;
      height: 206px;
      padding: 6px;
      display: grid;
      place-items: center;
      overflow: hidden;
      border: 5px solid transparent;
      border-radius: 18px;
      background:
        linear-gradient(#ffffff, #ffffff) padding-box,
        linear-gradient(145deg, #2478bd, #28a86b, #e88324) border-box;
      box-shadow: 0 16px 34px rgba(16, 42, 67, 0.13);
    }

    .member-simple-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 12px;
    }

    .member-simple-content {
      min-width: 0;
    }

    .member-simple-department {
      margin: 0;
      color: #175f9b;
      font-size: 1rem;
      font-weight: 850;
    }

    .member-simple-content h1 {
      margin: 10px 0 0;
      color: #102a43;
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.96;
      letter-spacing: -0.055em;
    }

    .member-simple-programme {
      width: fit-content;
      margin: 18px 0 0;
      padding: 7px 12px;
      color: #a3113a;
      border-radius: 999px;
      background: #fff0f5;
      font-size: 0.78rem;
      font-weight: 850;
    }

    .member-simple-lab {
      margin: 15px 0 0;
      color: #102a43;
      font-weight: 850;
    }

    .member-contact-links {
      margin-top: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      align-items: center;
    }

    .member-email-text {
      margin: 14px 0 0;
      color: #175f9b;
      font-size: 0.9rem;
      font-weight: 750;
      overflow-wrap: anywhere;
    }

    .member-email-text a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .member-email-text a:hover,
    .member-email-text a:focus-visible {
      color: #102a43;
    }

    .member-contact-link {
      min-height: 38px;
      padding: 8px 11px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #175f9b;
      border: 1px solid #cfe0ee;
      border-radius: 999px;
      background: #f4f9fd;
      font-size: 0.8rem;
      font-weight: 800;
      text-decoration: none;
    }

    .member-contact-link:hover,
    .member-contact-link:focus-visible {
      color: #ffffff;
      border-color: #175f9b;
      background: #175f9b;
    }

    .member-contact-link.email::before {
      content: "✉";
    }

    .member-contact-link.scholar::before {
      content: "G";
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: #ffffff;
      border-radius: 50%;
      background: #4285f4;
      font-size: 0.72rem;
      font-weight: 900;
    }

    .member-contact-link.linkedin::before {
      content: "in";
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: #ffffff;
      border-radius: 4px;
      background: #0a66c2;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.66rem;
      font-weight: 900;
    }

    .member-contact-link.orcid::before {
      content: "iD";
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: #ffffff;
      border-radius: 50%;
      background: #a6ce39;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.6rem;
      font-weight: 900;
    }

    .member-contact-link.github::before {
      content: "GH";
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: #ffffff;
      border-radius: 50%;
      background: #24292f;
      font-size: 0.56rem;
      font-weight: 900;
    }

    .member-contact-link.latrobe::before {
      content: "LT";
      width: 20px;
      height: 20px;
      display: grid;
      place-items: center;
      color: #ffffff;
      border-radius: 5px;
      background: #6f2da8;
      font-size: 0.58rem;
      font-weight: 900;
    }

    .member-summary-grid {
      margin-top: 24px;
      display: grid;
      grid-template-columns: 1.55fr 0.85fr;
      gap: 20px;
    }

    .member-summary-box {
      padding: 25px 28px;
      border: 1px solid #dce5ed;
      border-radius: 18px;
      background: #ffffff;
    }

    .member-summary-box h2 {
      margin: 0;
      color: #102a43;
      font-size: 1rem;
    }

    .member-summary-box p {
      margin: 10px 0 0;
      color: #5f6b7a;
    }

    .member-detail-layout {
      margin-top: 24px;
      display: grid;
      grid-template-columns: 245px minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }

    .member-detail-nav {
      position: sticky;
      top: 102px;
      padding: 18px;
      display: grid;
      gap: 4px;
      border: 1px solid #dce5ed;
      border-radius: 18px;
      background: #ffffff;
    }

    .member-detail-nav a {
      padding: 9px 11px;
      color: #34465a;
      border-radius: 9px;
      font-size: 0.8rem;
      font-weight: 750;
      text-decoration: none;
    }

    .member-detail-nav a:hover {
      color: #175f9b;
      background: #edf5fb;
    }

    .member-detail-sections {
      display: grid;
      gap: 18px;
    }

    .member-detail-section {
      padding: 29px 32px;
      scroll-margin-top: 105px;
      border: 1px solid #dce5ed;
      border-radius: 20px;
      background: #ffffff;
    }

    .member-detail-section h2 {
      margin: 0;
      color: #102a43;
      font-size: 1.25rem;
    }

    .member-detail-section p,
    .member-detail-section li {
      color: #5f6b7a;
    }

    .member-detail-section ul,
    .member-detail-section ol {
      margin: 14px 0 0;
      padding-left: 22px;
    }

    .member-detail-section li + li {
      margin-top: 10px;
    }

    .member-detail-back {
      margin-top: 24px;
      display: inline-flex;
      font-weight: 850;
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .member-simple-hero {
        grid-template-columns: 195px minmax(0, 1fr);
        gap: 36px;
      }

      .member-simple-avatar {
        width: 178px;
        height: 178px;
      }

      .member-summary-grid,
      .member-detail-layout {
        grid-template-columns: 1fr;
      }

      .member-detail-nav {
        position: static;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 650px) {
      .member-page-main {
        padding-top: 30px;
      }

      .member-simple-hero {
        grid-template-columns: 1fr;
        gap: 22px;
        padding: 30px 24px;
        text-align: center;
      }

      .member-simple-avatar {
        margin-inline: auto;
      }

      .member-simple-content {
        display: grid;
        justify-items: center;
      }

      .member-contact-links {
        justify-content: center;
      }

      .member-detail-nav {
        grid-template-columns: 1fr;
      }

      .member-detail-section,
      .member-summary-box {
        padding: 24px;
      }
    }
  </style>
</head>


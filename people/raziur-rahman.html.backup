<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Raziur Rahman | LUMEN-X Lab</title>
  <meta
    name="description"
    content="Academic profile of Raziur Rahman, joint doctoral researcher in adaptive scheduling and resource allocation for 6TiSCH-based IoT networks."
  >

  <link rel="canonical" href="https://lumenxlab.org/people/raziur-rahman.html">
  <meta property="og:title" content="Raziur Rahman | LUMEN-X Lab">
  <meta
    property="og:description"
    content="Joint doctoral researcher working on adaptive scheduling, resource allocation and mobility-aware operation in IEEE 802.15.4 TSCH and 6TiSCH-based IoT networks."
  >
  <meta property="og:type" content="profile">
  <meta property="og:url" content="https://lumenxlab.org/people/raziur-rahman.html">
